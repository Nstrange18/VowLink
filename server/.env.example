# LOCAL DEVELOPMENT example. Copy to server/.env; never commit real credentials.
# Required = core app; feature-required = needed only for that integration.
# Production: configure values in Render, NODE_ENV=production, and an Atlas DB.

# Core (required)
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/vowlink_dev
JWT_SECRET=
JWT_REFRESH_SECRET=
# Fill both secrets with independent strong random values before starting auth.
# Prefer a replica set/Atlas for production-compatible RSVP transactions.
# Loopback standalone fallback is development-only; see RSVP_OPERATIONS.md.

# URLs (set explicitly; origins only, no /api). Production: https://vowlink.co
PUBLIC_SITE_URL=http://localhost:5173
# Optional compatibility aliases, also accepted as CORS origins:
CLIENT_URL=http://localhost:5173
FRONTEND_URL=
# Optional additional CORS origins, comma-separated (no paths):
FRONTEND_URLS=
ALLOWED_ORIGINS=
# Optional; default 5000. Respect Render's supplied PORT in production.
PORT=5000

# Brevo HTTPS email (feature-required: API key + verified sender address)
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=
# Optional; default VowLink:
EMAIL_FROM_NAME=VowLink
# Optional; omitted when blank:
EMAIL_REPLY_TO=
# Optional; blank retains the existing venue-admin notification recipient:
EMAIL_ADMIN_ADDRESS=

# Paystack (feature-required for payments; use test keys locally)
PAYSTACK_SECRET_KEY=
# Public counterpart belongs in client/.env as VITE_PAYSTACK_PUBLIC_KEY.

# Cloudinary (feature-required for uploads/media management)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# WhatsApp Cloud API (feature-required for automated sends; leave blank locally
# unless intentionally testing an approved sandbox recipient)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Webhooks: verify token for GET challenge, app secret for POST signatures.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Optional signing aliases; precedence WHATSAPP_APP_SECRET > META > FACEBOOK.
META_APP_SECRET=
FACEBOOK_APP_SECRET=
# Optional settings below show current invitation code defaults.
WHATSAPP_GRAPH_API_VERSION=v20.0
WHATSAPP_INVITE_TEMPLATE_NAME=vowlink_invitation
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_GUEST_NAME_PARAMETER=guest_name
WHATSAPP_INVITE_MESSAGE_PARAMETER=invite_message
# Legacy alias for invite_message's parameter NAME, not an invitation URL.
# Used only when WHATSAPP_INVITE_MESSAGE_PARAMETER is unset:
WHATSAPP_INVITE_LINK_PARAMETER=
WHATSAPP_URL_BUTTON_INDEX=0
WHATSAPP_URL_BUTTON_VALUE_MODE=slug
# Optional stable usage-fingerprint secret; defaults to JWT_SECRET.
WHATSAPP_USAGE_HASH_SECRET=
# Reminders reuse credentials; their template/settings are code constants.

# Reserved AI settings (optional; generation is currently locked in code).
# AI_API_SECRET_KEY takes precedence; setting a key does not unlock generation.
OPENAI_API_KEY=
AI_API_SECRET_KEY=
