{
  "buildCommand": "npm --prefix client install && npm --prefix client run build",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/invite/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": {
            "re": ".*([Ww]hats[Aa]pp|[Ff]acebook[Ee]xternal[Hh]it|[Tt]witterbot|[Ss]lackbot|[Dd]iscordbot|[Tt]elegram[Bb]ot|[Ll]inked[Ii]n[Bb]ot).*"
          }
        }
      ],
      "destination": "/api/share-preview?slug=:slug"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
