# Copy to client/.env. Every VITE_ value is public in the browser build.
# Never put provider secret keys, JWT secrets, or database credentials here.

# API base INCLUDING /api. Required in production; localhost has this fallback.
VITE_API_URL=http://localhost:5000/api
# Optional canonical origin; defaults to the current browser origin.
# Production: https://vowlink.co
VITE_PUBLIC_SITE_URL=http://localhost:5173
# Feature-required for Paystack checkout; public key only, test key locally.
VITE_PAYSTACK_PUBLIC_KEY=

# Optional Vercel serverless share-preview aliases (not browser configuration).
# VITE_API_URL takes precedence over API_URL; include /api in either.
API_URL=
# Site precedence: VITE_PUBLIC_SITE_URL > PUBLIC_SITE_URL > SITE_URL > request host.
PUBLIC_SITE_URL=
SITE_URL=
# Set deployed function values in Vercel's environment settings as well.
